{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mobile": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --coverage && npm run quality:coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "quality:bundle": "node scripts/check-bundle-size.mjs",
    "quality:coverage": "node scripts/check-targeted-coverage.mjs",
    "quality:lighthouse": "lhci autorun",
    "quality:cloudflare": "npm run cloudflare:build && node scripts/check-cloudflare-worker.mjs",
    "cloudflare:build": "cross-env CLOUDFLARE_DEPLOYMENT=true opennextjs-cloudflare build",
    "cloudflare:preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "cloudflare:dry-run": "npm run cloudflare:build && wrangler deploy --dry-run",
    "cloudflare:deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "cloudflare:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "posthog-js": "^1.434.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.12",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "serialize-javascript": "7.0.5",
    "next": {
      "postcss": "8.5.10"
    }
  }
}
